# ---- SlotSure environment (copy to .env; the app refuses to start if a secret is missing or < 32 bytes) ----

# Database — must allow: CREATE EXTENSION btree_gist
DATABASE_URL=postgresql://slotsure:slotsure@localhost:5432/slotsure?schema=public

# Secrets (generate with: openssl rand -base64 48)
AGENT_API_KEY=replace-with-48-random-bytes-base64
ADMIN_TOKEN=replace-with-48-random-bytes-base64
QUOTE_SECRET=replace-with-32plus-random-bytes
CODE_SECRET=replace-with-32plus-random-bytes

# Business
BUSINESS_TZ=Asia/Kolkata

# HTTP / CORS
PORT=3000
DASHBOARD_ORIGIN=http://localhost:5173

# Public domain for the deployed API (used by deploy/Caddyfile for TLS). Leave blank for local dev;
# set to e.g. api.yourdomain.com on a VM, with its DNS A record pointing at the host.
API_DOMAIN=

# ---- Integration registry (composition root picks adapters from these flags) ----
# Driven ports -> concrete adapters. Change here, never in core.
STORE=postgres              # postgres
LIMITER=memory              # memory | redis
CALENDAR=noop               # noop | google | outlook      (demo MUST be noop)
NOTIFY=none                 # none | email | sms | whatsapp (demo MUST be none)
AGENT_ADAPTER=rest          # rest | mcp   (decided in Phase 1)

# Demo-only controls
FAULTS_ENABLED=true         # true on demo env, false elsewhere — guards /admin/faults
LOG_LEVEL=info
