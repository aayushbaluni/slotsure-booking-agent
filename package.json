{
  "name": "slotsure",
  "version": "0.1.0",
  "private": true,
  "description": "SlotSure — a published Agentplace booking agent backed by a reliability-first booking API.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @slotsure/api test",
    "test:e2e": "pnpm --filter @slotsure/dashboard test:e2e",
    "db:migrate": "pnpm --filter @slotsure/api db:migrate",
    "db:seed": "pnpm --filter @slotsure/api db:seed",
    "reset": "pnpm --filter @slotsure/api reset",
    "design:build": "pnpm --filter @slotsure/shared design:build"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0",
    "eslint": "^9.13.0",
    "typescript-eslint": "^8.10.0"
  }
}
