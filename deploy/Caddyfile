# SlotSure reverse proxy. Caddy obtains + renews TLS automatically (Let's Encrypt) for API_DOMAIN,
# so Agentplace can reach https://<API_DOMAIN>/mcp. API_DOMAIN is injected from .env by compose.
# The DNS A record for API_DOMAIN must point at this VM's public IP before first start.

{$API_DOMAIN} {
	encode gzip
	reverse_proxy api:3000
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}

