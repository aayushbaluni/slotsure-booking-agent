// SlotSure schema (build spec §4). Prisma 7: connection URL lives in prisma.config.ts and the
// client is created with @prisma/adapter-pg, so `datasource` holds only the provider.
// Overlap is prevented by a Postgres exclusion constraint (see migrations), not app code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id               String         @id
  name             String
  timezone         String // IANA, e.g. "Asia/Kolkata"
  currency         String // "INR"
  capabilities     String[] // server-owned, verified; the agent answers "can you do X?" from this
  minLeadMins      Int            @default(60)
  maxDaysAhead     Int            @default(14)
  slotStepMins     Int            @default(15)
  cancelCutoffMins Int            @default(120)
  resetGeneration  Int            @default(1) // bumped by every demo reset; quotes carry it
  services         Service[]
  staff            Staff[]
  hours            OpeningHours[]
  closures         Closure[]
  bookings         Booking[]
}

model Service {
  id           String         @id // stable slug: "discovery-call"
  businessId   String
  name         String
  description  String         @default("")
  aliases      String[]
  durationMins Int
  bufferMins   Int            @default(0)
  pricePaise   Int
  active       Boolean        @default(true)
  version      Int            @default(1) // bumped on any edit; quotes carry it
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff        StaffService[]
  bookings     Booking[]

  @@index([businessId])
}

model Staff {
  id          String         @id
  businessId  String
  displayName String
  sortOrder   Int
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services    StaffService[]
  bookings    Booking[]

  @@unique([businessId, sortOrder])
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
}

model OpeningHours {
  id         String   @id @default(cuid())
  businessId String
  weekday    Int // ISO 1 = Monday … 7 = Sunday
  opensAt    String // "18:00" local
  closesAt   String // "21:00" local
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, weekday, opensAt])
}

model Closure {
  id         String   @id @default(cuid())
  businessId String
  date       String // "2026-11-01" local
  reason     String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}

model Booking {
  id             String         @id @default(cuid())
  businessId     String
  reference      String         @unique // "SB-7K2Q9" (Crockford base32)
  manageCodeHash String // SHA-256 of the derived code
  quoteId        String         @unique // request key; replay anchor
  serviceId      String
  staffId        String
  startsAt       DateTime       @db.Timestamptz(3)
  endsAt         DateTime       @db.Timestamptz(3) // start + snapshot duration
  blockedUntil   DateTime       @db.Timestamptz(3) // end + snapshot buffer
  serviceName    String
  durationMins   Int
  bufferMins     Int
  pricePaise     Int
  serviceVersion Int
  generation     Int // reset generation the quote was issued in
  customerName   String
  projectType    String
  timeline       String?
  projectBrief   String
  status         BookingStatus  @default(CONFIRMED)
  isDemo         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  cancelledAt    DateTime?      @db.Timestamptz(3)
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service        Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff          Staff          @relation(fields: [staffId], references: [id], onDelete: Restrict)
  events         BookingEvent[]

  @@index([staffId, startsAt])
  @@index([businessId, startsAt])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String?
  type      String // created | replayed | conflict_rejected | cancelled | cancel_replayed | lookup_denied
  requestId String
  detail    Json // never name, brief or code
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([createdAt])
}

model AccessAttempt {
  id        String   @id @default(cuid())
  reference String
  clientKey String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([reference, createdAt])
  @@index([clientKey, createdAt])
}

model IdempotencyRecord {
  key         String   @id
  requestHash String
  status      Int
  response    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}
